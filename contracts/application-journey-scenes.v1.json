  "version": 1,
  "parent_issue": "https://github.com/EndeavorEverlasting/EscapeHatch/issues/69",
  "owner": "docs/APPLICATION_ASSIST_AUTOPILOT_PLAN.md",
  "purpose": "Single scene and transition registry shared by installer, cockpit, managed browser, prerequisite collector, QA and agent handoffs.",
  "scenes": [
    {
      "id": "INSTALL_ACQUIRE",
      "entry_evidence": "downloaded entrypoint",
      "required_evidence": [
        "source_checkout"
      ],
      "coach_prompt": "Install EscapeHatch",
      "primary_action": "GET_EH",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "INSTALL_PREFLIGHT",
      "entry_evidence": "installer started",
      "required_evidence": [
        "source_checkout",
        "runtime_dependencies",
        "install_destination"
      ],
      "coach_prompt": "Check the prerequisites for this device",
      "primary_action": "INSTALL_DIAGNOSE",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "INSTALL_APPROVAL",
      "entry_evidence": "missing dependency or install option",
      "required_evidence": [
        "dependency_consent",
        "selected_source"
