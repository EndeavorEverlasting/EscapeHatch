{
  "schema": "escapehatch/application-assist-session/v1",
  "version": 1,
  "mission": "Persistent same-application assist session that fills deterministic allowed identity/contact fields through a canonical Fill Plan, may advance safe intermediate pages via a gated Progression Plan and navigation adapter, and handles account-bootstrap states with session-scoped secret invariants, while final submission, attestation, CAPTCHA and MFA remain manual.",
  "architecture": {
    "pipeline": [
      "user_owned_state",
      "canonical_fill_plan",
      "policy_gate",
      "dom_writer"
    ],
    "invariant": "no_dom_write_may_bypass_canonical_fill_plan",
    "pipeline_extension": {
      "progression": "navigation_adapter_gated_by_progression_plan",
      "order": "after_dom_writer",
      "gate": "progression_gate",
      "invariant": "no_navigation_may_bypass_progression_plan",
      "full_pipeline": [
        "user_owned_state",
        "canonical_fill_plan",
        "policy_gate",
        "dom_writer",
        "progression_plan",
        "progression_gate",
        "navigation_adapter"
      ],
      "note": "Original fill pipeline stays sealed; progression is a gated navigation_adapter after dom_writer verified by the Progression Plan."
    },
    "extended_pipeline_documentation": "user-owned state -> page classification -> Fill Plan -> field policy gate -> DOM writer -> Progression Plan -> progression policy gate -> navigation adapter. No navigation may bypass the Progression Plan."
  },
  "surfaces": {
    "browser_extension": {
      "path": "browser/application-assist",
      "manifest_version": 3,
      "permissions": [
        "activeTab",
        "scripting",
        "storage"
      ],
      "host_permissions": "none",
      "background_service": "none",
      "always_on_content_script": false
    }
  },
  "storage": {
    "profile_key": "escapeHatch.applicationAssistProfile.v1",
    "session_key": "escapeHatch.applicationAssistSession.v1",
    "ownership": "user",
    "persistence": "browser-local",
    "repository_tracking": "forbidden",
    "legacy_autofill_profile_key": "escapeHatch.applicationAutofillProfile.v1"
  },
  "portability": {
    "export_schema": "escapehatch-application-assist-profile/v2",
    "max_import_bytes": 65536,
    "accepted_import_schemas": [
      "escapehatch-application-assist-profile/v2",
      "escapehatch-application-assist-profile/v1",
      "escapehatch-application-autofill-profile/v1"
    ],
    "security": [
      "reject_oversized_payload",
      "reject_unsupported_schema",
      "accept_only_known_profile_keys",
      "never_execute_imported_content",
      "never_commit_real_profile_values",
      "legacy_phone_defaults_to_unconfirmed"
    ]
  },
  "session": {
    "binding": "same_application_origin",
    "statuses": [
      "idle",
      "active",
      "paused",
      "stopped"
    ],
    "controls": [
      "Start Assist",
      "Fill Allowed Fields",
      "Pause",
      "Resume",
      "Emergency Stop",
      "Undo Last Fill",
      "Record Confirmation Evidence"
    ],
    "cross_origin_transition": "pause",
    "stop_cancels_future_writes": true,
    "pause_blocks_writes": true
  },
  "fill_plan": {
    "authority": "canonical",
    "allowed_families": [
      "identity-contact"
    ],
    "item_fields": [
      "index",
      "profile_key",
      "question_id",
      "value",
      "decision"
    ],
    "writer_rule": "dom_writer_executes_only_gate_allowed_plan_items"
  },
  "policy_gate": {
    "rules": [
      "session_must_be_active",
      "field_must_be_empty_or_escapehatch_owned_for_undo_only",
      "preserve_existing_and_user_edited_values",
      "unknown_fields_stay_blank",
      "attestation_manual_only",
      "no_password_file_hidden_or_disallowed_types",
      "select_requires_exact_normalized_option_match",
      "taxonomy_automation_policy_must_allow_fill",
      "phone_requires_explicit_user_confirmed_primary_contact_authority"
    ],
    "forbidden_actions": [
      "auto_submit",
      "auto_attestation",
      "broad_host_permissions",
      "page_runtime_network_requests"
    ]
  },
  "progression": {
    "schema_version": "escapehatch/application-progression/v1",
    "version": 1,
    "decisions": [
      "AUTO_ADVANCE_SAFE",
      "REVIEW_REQUIRED"
    ],
    "states": [
      "AUTO_ADVANCE_SAFE",
      "REVIEW_REQUIRED"
    ],
    "decision_enum": [
      "AUTO_ADVANCE_SAFE",
      "REVIEW_REQUIRED"
    ],
    "terminal_forbidden": [
      "submit",
      "apply",
      "finish",
      "send",
      "certify",
      "sign",
      "accept",
      "attestation",
      "captcha",
      "mfa",
      "otp",
      "verification",
      "unknown",
      "manual"
    ],
    "terminal_manual_reasons": [
      "final_submit",
      "apply_action",
      "certification_required",
      "attestation_required",
      "legal_compliance_pending",
      "captcha_present",
      "mfa_required",
      "otp_required",
      "verification_required",
      "file_upload_required",
      "unknown_control",
      "ambiguous_progression",
      "validation_error_present",
      "manual_review_required",
      "password_outside_account_creation",
      "demographic_decision_required"
    ],
    "intermediate_policy": {
      "allowed_when": [
        "session_is_active_and_not_emergency_stopped",
        "current_page_archetype_is_recognized",
        "candidate_control_uniquely_identified_as_intermediate_next_or_continue",
        "candidate_is_not_submit_apply_finish_certify_sign_accept_attestation",
        "deterministic_fill_completed_and_stable_after_live_rescan",
        "no_visible_validation_error_present",
        "no_required_unknown_manual_review_control_unresolved",
        "no_password_requested_outside_explicit_account_bootstrap_state",
        "no_file_upload_captcha_mfa_otp_legal_compliance_attestation_demographic_gate_unresolved",
        "action_identity_unchanged_between_plan_construction_and_execution",
        "advance_budget_loop_guard_not_exceeded",
        "next_observed_page_transition_matches_permitted_state_transition"
      ],
      "allowed_when_gates": [
        "session_is_active_and_not_emergency_stopped",
        "current_page_archetype_is_recognized",
        "candidate_control_uniquely_identified_as_intermediate_next_or_continue",
        "candidate_is_not_submit_apply_finish_certify_sign_accept_attestation",
        "deterministic_fill_completed_and_stable_after_live_rescan",
        "no_visible_validation_error_present",
        "no_required_unknown_manual_review_control_unresolved",
        "no_password_requested_outside_explicit_account_bootstrap_state",
        "no_file_upload_captcha_mfa_otp_legal_compliance_attestation_demographic_gate_unresolved",
        "action_identity_unchanged_between_plan_construction_and_execution",
        "advance_budget_loop_guard_not_exceeded",
        "next_observed_page_transition_matches_permitted_state_transition"
      ],
      "required_stability": "fill_stable_after_rescan"
    },
    "allowed_when": [
      "session_is_active_and_not_emergency_stopped",
      "current_page_archetype_is_recognized",
      "candidate_control_uniquely_identified_as_intermediate_next_or_continue",
      "candidate_is_not_submit_apply_finish_certify_sign_accept_attestation",
      "deterministic_fill_completed_and_stable_after_live_rescan",
      "no_visible_validation_error_present",
      "no_required_unknown_manual_review_control_unresolved",
      "no_password_requested_outside_explicit_account_bootstrap_state",
      "no_file_upload_captcha_mfa_otp_legal_compliance_attestation_demographic_gate_unresolved",
      "action_identity_unchanged_between_plan_construction_and_execution",
      "advance_budget_loop_guard_not_exceeded",
      "next_observed_page_transition_matches_permitted_state_transition"
    ],
    "allowed_when_gates": [
      "session_is_active_and_not_emergency_stopped",
      "current_page_archetype_is_recognized",
      "candidate_control_uniquely_identified_as_intermediate_next_or_continue",
      "candidate_is_not_submit_apply_finish_certify_sign_accept_attestation",
      "deterministic_fill_completed_and_stable_after_live_rescan",
      "no_visible_validation_error_present",
      "no_required_unknown_manual_review_control_unresolved",
      "no_password_requested_outside_explicit_account_bootstrap_state",
      "no_file_upload_captcha_mfa_otp_legal_compliance_attestation_demographic_gate_unresolved",
      "action_identity_unchanged_between_plan_construction_and_execution",
      "advance_budget_loop_guard_not_exceeded",
      "next_observed_page_transition_matches_permitted_state_transition"
    ],
    "loop_guard": {
      "max_advances_per_session": 20,
      "max_advances_per_page": 3,
      "require_page_transition": true,
      "detect_repeated_page": true,
      "budget_scope": "per_session_and_per_page",
      "description": "Prevents repeated auto-advance loops; requires observed page transition and budget ceiling."
    },
    "final_submit_boundary": {
      "never_auto_submit": true,
      "manual_only_controls": [
        "submit",
        "apply",
        "finish",
        "send",
        "certify",
        "attestation",
        "captcha",
        "mfa",
        "unknown"
      ],
      "require_operator_confirmation": true,
      "attestation_manual_only": true,
      "description": "Final Apply/Submit/Finish/Send and certification/attestation remain manual-only; no Progression Plan may advance them."
    },
    "pipeline_extension": {
      "after": "dom_writer",
      "adapter": "navigation_adapter",
      "gate": "progression_gate",
      "invariant": "no_navigation_may_bypass_progression_plan"
    }
  },
  "account_bootstrap": {
    "schema_version": "escapehatch/application-account-bootstrap/v1",
    "version": 1,
    "states": [
      "APPLICATION_ENTRY",
      "EMAIL_PROBE",
      "EXISTING_ACCOUNT_LOGIN",
      "CREATE_ACCOUNT_CHOICE",
      "ACCOUNT_CREATION",
      "VERIFICATION_REQUIRED",
      "APPLICATION_FORM",
      "AUTH_MISMATCH",
      "CAPTCHA_REQUIRED",
      "MFA_REQUIRED",
      "REVIEW_REQUIRED"
    ],
    "initial_state": "APPLICATION_ENTRY",
    "terminal_manual_states": [
      "AUTH_MISMATCH",
      "CAPTCHA_REQUIRED",
      "MFA_REQUIRED",
      "REVIEW_REQUIRED"
    ],
    "transitions": {
      "APPLICATION_ENTRY": [
        "EMAIL_PROBE"
      ],
      "EMAIL_PROBE": [
        "EXISTING_ACCOUNT_LOGIN",
        "CREATE_ACCOUNT_CHOICE",
        "ACCOUNT_CREATION",
        "CAPTCHA_REQUIRED",
        "REVIEW_REQUIRED"
      ],
      "EXISTING_ACCOUNT_LOGIN": [
        "APPLICATION_FORM",
        "VERIFICATION_REQUIRED",
        "AUTH_MISMATCH",
        "CAPTCHA_REQUIRED",
        "MFA_REQUIRED",
        "REVIEW_REQUIRED"
      ],
      "CREATE_ACCOUNT_CHOICE": [
        "ACCOUNT_CREATION",
        "EXISTING_ACCOUNT_LOGIN",
        "REVIEW_REQUIRED"
      ],
      "ACCOUNT_CREATION": [
        "VERIFICATION_REQUIRED",
        "APPLICATION_FORM",
        "CAPTCHA_REQUIRED",
        "REVIEW_REQUIRED"
      ],
      "VERIFICATION_REQUIRED": [
        "APPLICATION_FORM",
        "MFA_REQUIRED",
        "CAPTCHA_REQUIRED",
        "REVIEW_REQUIRED"
      ],
      "APPLICATION_FORM": [
        "APPLICATION_FORM",
        "REVIEW_REQUIRED",
        "CAPTCHA_REQUIRED",
        "MFA_REQUIRED",
        "AUTH_MISMATCH"
      ],
      "AUTH_MISMATCH": [
        "REVIEW_REQUIRED"
      ],
      "CAPTCHA_REQUIRED": [
        "REVIEW_REQUIRED"
      ],
      "MFA_REQUIRED": [
        "REVIEW_REQUIRED"
      ],
      "REVIEW_REQUIRED": [
        "REVIEW_REQUIRED"
      ]
    },
    "secret_handling": {
      "generation_allowed_only_in": "ACCOUNT_CREATION",
      "generation_states": [
        "ACCOUNT_CREATION"
      ],
      "persistence": "session_scoped",
      "storage": "session_scoped",
      "never_commit": true,
      "never_log": true,
      "never_export": true,
      "never_commit_secret": true,
      "never_log_secret": true,
      "never_export_secret": true,
      "fixtures": "synthetic_placeholders_only",
      "fixture_placeholders": "synthetic_non_secret_placeholders_only",
      "reveal": "user_visible_copy_action_only",
      "handoff": "explicit_change_save_after_creation",
      "note": "Generated temporary credentials live only in browser session storage, never in Git, logs, exports, telemetry, or progress receipts; fixtures use synthetic placeholders."
    }
  },
  "undo": {
    "scope": "last_fill_batch",
    "restores": "only_untouched_escapehatch_inserted_values",
    "user_edited_after_fill": "leave_in_place"
  },
  "evidence": {
    "confirmation_recording": "user_invoked",
    "allowed_sources": [
      "explicit_user_action",
      "same_session_page_confirmation",
      "user_confirmed_external_evidence"
    ],
    "companion_contract": "escapehatch/application-companion/v1",
    "companion_export_schema": "escapehatch-application-companion-session/v1",
    "stores_profile_values": false
  },
  "taxonomy_binding": {
    "owner": "harness/contracts/application-form-taxonomy.v1.json",
    "runtime_enforcement": "question_automation_policy_mirror_in_assist_core",
    "profile_key_to_question_id": {
      "name_prefix": "identity.title",
      "first_name": "identity.first_name",
      "last_name": "identity.last_name",
      "preferred_name": "identity.preferred_name",
      "email": "identity.email",
      "phone": "identity.phone",
      "linkedin_url": "identity.linkedin",
      "street_address": "identity.street_address",
      "city": "identity.city",
      "region": "identity.region",
      "postal_code": "identity.postal_code",
      "country": "identity.country"
    }
  },
  "preference_policy": "harness/contracts/application-preference-cache.v1.json",
  "modality_contract": "contracts/application-assist-modality.v1.json",
  "preference_runtime": {
    "storage_key": "escapeHatch.applicationQuestionPreferences.v1",
    "precedence": [
      "session_confirmation",
      "opportunity_override",
      "profile_preference"
    ],
    "assist_profile_projects_to_profile_preference_on_save": true
  },
  "proof_ceiling": [
    "repository_contract_and_runtime_tests",
    "unpacked_extension_control_loop_requires_observed_browser_proof",
    "no_live_ats_compatibility_claim"
  ],
  "contact_authority": {
    "phone_values": [
      "unconfirmed",
      "user_confirmed_primary",
      "secondary_or_forwarded"
    ],
    "default": "unconfirmed",
    "fill_requires": "user_confirmed_primary",
    "principle": "observed_or_previously_used_contact_is_not_preferred_contact_authority",
    "privacy_tradeoff": "operator_may_choose_a_more_direct_or_database_joining_channel_when_they_explicitly_value_control_and_reachability"
  }
}
