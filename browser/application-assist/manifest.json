{
  "manifest_version": 3,
  "name": "EscapeHatch Application Assist",
  "version": "1.3.0",
  "description": "Same-application assist session that fills only policy-gated identity fields through a canonical Fill Plan. Never submits.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "16": "icons/mascot-16.png",
    "32": "icons/mascot-32.png",
    "48": "icons/mascot-48.png",
    "128": "icons/mascot-128.png"
  },
  "action": {
    "default_title": "EscapeHatch Application Assist",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/mascot-16.png",
      "32": "icons/mascot-32.png",
      "48": "icons/mascot-48.png",
      "128": "icons/mascot-128.png"
    }
  }
}
