      "coach_prompt": "Check this job and show me what is missing",
      "primary_action": "INSPECT_JOB",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "PREREQUISITES",
      "entry_evidence": "source/profile/form inventory available",
      "required_evidence": [
        "approved_identity",
        "approved_answers",
        "reviewed_role_documents"
      ],
      "coach_prompt": "Ask me only for information you cannot verify",
      "primary_action": "COLLECT_MISSING",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "APPLICATION_ENTRY",
      "entry_evidence": "managed browser launched",
      "required_evidence": [
        "expected_origin",
        "opportunity_binding"
      ],
      "coach_prompt": "Open the employer application",
      "primary_action": "OPEN_APPLICATION",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "AUTH_HANDOFF",
      "entry_evidence": "login or email-first gate visible",
      "required_evidence": [
        "user_login"
      ],
      "coach_prompt": "Sign in in the employer window; I will recognize when the form is available",
      "primary_action": "AUTH_WATCH",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "AUTH_RECHECK",
      "entry_evidence": "employer page changed after sign-in",
      "required_evidence": [
        "same_opportunity",
        "recognized_form",
        "stable_readback"
      ],
      "coach_prompt": "Check again or continue when ready",
      "primary_action": "AUTH_VERIFY",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "FORM_PREPARATION",
      "entry_evidence": "application form verified on employer origin",
      "required_evidence": [
        "allowed_fill_plan",
        "document_review"
      ],
      "coach_prompt": "Resume my saved application preparation",
      "primary_action": "PREPARE_REVIEW",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "MANUAL_DECISION",
      "entry_evidence": "unanswered or protected question encountered",
      "required_evidence": [
        "explicit_operator_answer"
      ],
      "coach_prompt": "Answer this question so I can continue safely",
      "primary_action": "ANSWER_REQUIRED",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "FINAL_REVIEW",
      "entry_evidence": "trusted terminal control reached",
      "required_evidence": [
        "confirmed_fields",
        "verified_documents",
        "operator_review"
      ],
      "coach_prompt": "Review everything; submit yourself",
      "primary_action": "FINAL_OPERATOR_ONLY",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "RECOVERY",
      "entry_evidence": "blocked, drifted, interrupted, or degraded session",
      "required_evidence": [
        "failure_receipt",
        "safe_reentry"
      ],
      "coach_prompt": "Show the failed step and how to recover",
      "primary_action": "RECOVER",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    }
  ],
