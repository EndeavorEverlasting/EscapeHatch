  "state_authority": {
    "source": "provider-readback-and-local-user-owned-evidence",
    "never": "agent_claim_or_button_click_only",
    "installation": "Windows installer receipt + managed runtime healthy",
    "auth": "recognized same-application form stable across two status observations",
    "submission": "operator action + independent employer confirmation"
  },
  "user_prompts": {
    "display": "one_visible_question_at_a_time_with_why_and_destination",
    "choices": [
      "Answer now",
      "I'll do this in the employer window",
      "Skip if optional",
      "Review saved answer"
    ],
    "ask_when": "specific_missing_or_ambiguous_slot",
    "never_request": [
      "password",
      "MFA_code",
      "CAPTCHA_solution",
      "legal_attestation_via_autofill",
      "EEO_or_accommodation_choice_without_explicit_user_action"
    ],
    "write_policy": "approved_value_to_private_canonical_profile_or_opportunity_preferences_only",
    "answer_provenance": [
      "user_confirmed",
      "source_verified",
      "unresolved"
    ],
    "replace_authorized_values": false
  },
  "bootstrap": {
    "distribution": "downloadable_Get-EscapeHatch.cmd_windows",
    "depends_on_pr": 95,
    "script": "Get-EscapeHatch.cmd",
    "delegates_to": "Install-EscapeHatch.cmd",
    "install_receipt": "escapehatch-installation/v1",
    "require_one_click_download": false,
    "known_limit": "CMD downloader runs after Windows download/security prompts; not a signed EXE or MSI.",
    "missing_dependency_policy": "show prerequisite + ask before winget; do not silently modify OS",
    "source_policy": "clone separate dedicated checkout; preserve pre-existing installations and folders"
  },
  "auth_handoff": {
    "watch_interval_ms": 1500,
    "confirmed_on": "two_consecutive_same_page_readbacks_of_visible_application_form_on_same_origin_with_no_credential_gate",
    "on_unknown": "keep user signed in/browser state intact; provide Check again",
    "on_complete": "enable obvious Resume preparation action; auto-run only a previously authorized nonterminal fill, never final Submit",
    "on_external_identity_origin": "observe only origin, no inspect credentials or autofill",
    "on_page_mismatch": "block and preserve session; do not navigate or submit",
    "on_browser_close": "record interrupted state; offer reopen without declaring completion"
  },
  "final_submission": "operator_only",
  "privacy": {
    "repository": "synthetic_only",
    "credential_values": "never_collect_or_store",
    "private_answers": "local_user_owned_store"
  },
  "upstream_selection": [
    {
      "ref": "xyflow-reactflow",
      "use": "conceptual graph semantics only",
      "adoption": "DEFER"
    },
    {
      "ref": "browser-view-transitions",
      "use": "progressive scene transitions with reduced-motion fallback",
      "adoption": "ADAPT"
    },
    {
      "ref": "motion-animate-presence",
      "use": "optional existing React enter-exit continuity, not blocking flow",
      "adoption": "ADAPT"
    },
    {
      "ref": "mattpocock-wayfinder",
      "use": "typed decision map and unproven-gate visibility",
      "adoption": "ADAPT"
    },
    {
      "ref": "UP-60B0939CC",
      "use": "Playwright visual/scene regression",
      "adoption": "REVIEW"
    },
    {
      "ref": "UP-60FBA76B5",
      "use": "motion accessibility requirements",
      "adoption": "REVIEW"
    }
  ],
  "acceptance": [
    "no_login_is_not_false_filled",
    "login_return_seen_in_under_two_successful_status_polls",
    "manual_check_again_always_present",
    "no_credential_read_or_write",
    "opportunity_binding_preserved",
    "unknown_cross_origin_blocks_fill",
    "explicit_questions_have_destination_and_provenance",
    "bootstrap_entrypoint_delivers_installer_only_after_source_ready",
    "unknown_required_prerequisites_block_review_ready",
    "terminal_action_never_automated",
    "runtime_browser_proof_separate_from_synthetic_tests"
  ],
  "resume_persistence": {
    "storage_key": "escape-hatch-journey-resume",
    "storage_owner": "escapehatch-local-workspace/v1",
    "allowed_fields": [
      "opportunityId",
      "applicationUrl"
    ],
    "empty_value": {
      "opportunityId": "",
      "applicationUrl": ""
    },
    "opportunity_id_max_length": 128,
    "application_url_max_length": 2048,
    "url_policy": "public_https_no_credentials_or_nondefault_port",
    "binding": "exact_saved_nonterminal_opportunity_required",
    "authority": "selection_only_no_login_launch_fill_or_submit_authority",
    "context_readiness": false,
    "conflict_policy": "preserve_divergent_nonempty_pointers",
    "empty_semantics": "absence_default_not_forget_authority"
  },
  "pre_application_studio": {
    "version": 1,
    "authority": "Nested, optional scenes under HOME_READY and PREREQUISITES; existing 14 root scene IDs and their authority remain unchanged.",
    "identity_boundary": "Verified active owner/workspace first. Never mix applicant, developer, fixture or other owner. No answer/profile values in tracked Git.",
    "entry_policy": "Offer before first opportunity intake, not a forced quiz. Surface what is already known; ask for unknowns only; always allow partial completion and later return.",
    "data_routing": {
      "career_history": "Existing private career-state / AssistProfile; approved job titles, employer names, start and end dates; do not invent chronology.",
      "skills": "Experience-scoped reviewed skills only, attached to the exact career-role evidence; preserve draft PR #145's role-scoped skills owner and do not create a competing global skills truth.",
      "skill_interview_evidence": "Private career-claim evidence or reviewed role experience; an explainability prompt is not a claim of proficiency.",
      "reusable_answers": "Existing application-question preferences + approved answer-memory owner; never another store.",
      "opportunity_overrides": "Exact opportunity-bound private overlay; never promote salary, employer history, legal or current facts to global defaults.",
      "documents": "Approved canonical career master/role derivative and opportunity document store; no silent overwrite or unreviewed upload.",
      "progress": "Existing opportunity/workspace session owner; new read-only application-progress-checkpoint projection, not a second public database."
    },
    "subscenes": [
      {
        "id": "STUDIO_WELCOME",
        "owner_scene": "HOME_READY",
        "title": "Make the next application easier",
        "action": "REVIEW_KNOWN",
        "proof": "workspace_owner_and_known_answer_inventory"
      },
      {
        "id": "STUDIO_TIMELINE",
        "owner_scene": "HOME_READY",
        "title": "Experience and dates",
        "action": "REVIEW_EXPERIENCE",
        "proof": "reviewed_experience_dates_and_identity"
      },
      {
        "id": "STUDIO_ROLE_SKILLS",
        "owner_scene": "PREREQUISITES",
        "title": "Skills for each role",
        "action": "CONFIRM_ROLE_SKILLS",
        "proof": "role_id_skill_id_source_and_user_review"
      },
      {
        "id": "STUDIO_SKILL_STORIES",
        "owner_scene": "PREREQUISITES",
        "title": "Explain your skills",
        "action": "REVIEW_EVIDENCE",
        "proof": "private_skill_to_experience_example"
      },
      {
        "id": "STUDIO_ANSWERS",
        "owner_scene": "PREREQUISITES",
        "title": "Reusable application answers",
        "action": "SAVE_REUSABLE",
        "proof": "existing_private_answer_memory_readback"
      },
      {
        "id": "STUDIO_DOCUMENTS",
        "owner_scene": "PREREQUISITES",
        "title": "Career documents",
        "action": "REVIEW_DOCUMENTS",
        "proof": "approved_source_and_document_version"
      },
      {
        "id": "STUDIO_READY",
        "owner_scene": "HOME_READY",
        "title": "Your application kit",
        "action": "GO_TO_JOBS",
        "proof": "known_missing_fields_with_opt_in_review"
      },
      {
        "id": "APPLICATION_RESUME_CARD",
        "owner_scene": "RECOVERY",
        "title": "Continue this application",
        "action": "REINSPECT_CHECKPOINT",
        "proof": "same_owner_opportunity_origin_and_fresh_form_readback"
      },
      {
        "id": "APPLICATION_BLOCKER",
        "owner_scene": "MANUAL_DECISION",
        "title": "One thing needs your attention",
        "action": "RESOLVE_ONE",
        "proof": "specific_unresolved_control_or_operator_only_gate"
      }
    ],
    "transitions": [
      [
        "STUDIO_WELCOME",
        "STUDIO_TIMELINE"
      ],
      [
        "STUDIO_TIMELINE",
        "STUDIO_ROLE_SKILLS"
      ],
      [
        "STUDIO_ROLE_SKILLS",
        "STUDIO_SKILL_STORIES"
      ],
      [
        "STUDIO_SKILL_STORIES",
        "STUDIO_ANSWERS"
      ],
      [
        "STUDIO_ANSWERS",
        "STUDIO_DOCUMENTS"
      ],
      [
        "STUDIO_DOCUMENTS",
        "STUDIO_READY"
      ],
      [
        "STUDIO_READY",
        "OPPORTUNITY_INTAKE"
      ],
      [
        "STUDIO_READY",
        "STUDIO_ROLE_SKILLS"
      ],
      [
        "APPLICATION_RESUME_CARD",
        "FORM_PREPARATION"
      ],
      [
        "FORM_PREPARATION",
        "APPLICATION_BLOCKER"
      ],
      [
        "APPLICATION_BLOCKER",
        "FORM_PREPARATION"
      ]
    ],
    "recovery": "At any studio subscene, persist partial approved data to its existing owner and show the next missing step; authentication and terminal Submit are never inherited from a saved scene.",
    "preference": "Progressive, skippable onboarding; prefer 2-3 short guided screens per sitting over a giant upfront form; role-specific skills and six-skill ATS prompts are an evidence-backed reuse opportunity, never an invented quota.",
    "aesthetic": "Reuse existing Manrope/Newsreader/DM Mono typography, cream/teal design tokens, contextual Your next step coach and puzzle cards. Visible current/next/blocked/resume states; reduced-motion, keyboard, screen-reader, 320px and 200% zoom support.",
    "projection_module": "artifacts/escape-hatch/src/lib/preapplication-studio.ts",
    "projection_test": "artifacts/escape-hatch/src/lib/preapplication-studio.test.ts"
  },
  "application_progress_projection": {
    "projection_module": "artifacts/escape-hatch/src/lib/application-progress-checkpoint.ts",
    "snapshot_schema": "escapehatch/application-progress-checkpoint/v1",
    "scope": "one verified applicant + one bound opportunity + one same-employer application URL",
    "freshness_ms": 300000,
    "always_display": [
      "application_name",
      "current_section",
      "last_verified_checkpoint",
      "next_user_action",
      "verified_required_count",
      "unresolved_required_count",
      "evidence_scope"
    ],
    "nullable_estimates": [
      "observed_fields_percent",
      "position_estimate_percent"
    ],
    "never_claim": [
      "whole_application_completion_percent_without_full_employer_inventory",
      "browser_url_is_submission",
      "fill_is_employer_acceptance",
      "clicked_button_is_completion",
      "prior_page_receipt_is_current_evidence"
    ],
    "submission_proof": "independent employer confirmation receipt owned by existing listener/reconciliation; no auto-submit",
    "status_values": [
      "NOT_OBSERVED",
      "IN_PROGRESS",
      "NEEDS_USER",
      "BLOCKED",
      "READY_FOR_FINAL_REVIEW",
      "SUBMITTED_CONFIRMED"
    ],
    "privacy": "never print or commit field values, private career evidence, employer profile answers or protected choices",
    "no_second_tracker": "Use existing opportunity/tracker reconciliation; saved checkpoint is resumable user context, not authoritative ATS completion."
  }
}
