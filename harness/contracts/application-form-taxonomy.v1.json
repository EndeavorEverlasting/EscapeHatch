{
  "schema": "escapehatch/application-form-taxonomy/v1",
  "version": 1,
  "purpose": "Map application questions by meaning rather than employer, page number, DOM order, or ATS vendor so user-owned preferences can be reused safely.",
  "matching": {
    "order_independent": true,
    "employer_independent": true,
    "normalization": ["lowercase", "trim", "collapse_whitespace", "strip_required_marker", "compare_label_name_id_placeholder_and_nearby_text"],
    "option_matching": "normalized semantic option text; never invent an unavailable choice",
    "unknown_question_behavior": "leave_blank_and_surface_for_mapping"
  },
  "page_archetypes": [
    {"id":"identity-contact","question_ids":["identity.title","identity.first_name","identity.last_name","identity.preferred_name","identity.email","identity.phone","identity.linkedin","identity.street_address","identity.city","identity.region","identity.postal_code","identity.country"]},
    {"id":"eeo-demographics","question_ids":["eeo.disability_status","eeo.veteran_status","eeo.race_ethnicity","eeo.gender"]},
    {"id":"employment-eligibility","question_ids":["employment.prior_employer_relationship","employment.work_authorization_proof","employment.sponsorship_required"]},
    {"id":"compensation-education-accommodation","question_ids":["compensation.desired_annual_salary","compensation.currency","education.highest_completed_level","accommodation.reasonable_accommodation_needed"]},
    {"id":"legal-compliance","question_ids":["legal.non_compete_blocking","legal.debarment_exclusion_status","legal.debarment_investigation_pending"]},
    {"id":"certification-navigation","question_ids":["attestation.truth_accuracy"]},
    {"id":"role-fit-claims","question_ids":["skills.jira_administration_level","skills.confluence_level","skills.presentation_level","industry.utilities_energy_experience","credentials.relevant_certification_status"]}
  ],
  "questions": [
    {"id":"identity.title","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["title","select your title","salutation"]},
    {"id":"identity.first_name","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["first name","given name"]},
    {"id":"identity.last_name","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["last name","surname","family name"]},
    {"id":"identity.preferred_name","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["preferred name","preferred first name","nickname"]},
    {"id":"identity.email","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["email","email address"]},
    {"id":"identity.phone","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["phone number","phone","mobile phone","telephone"]},
    {"id":"identity.linkedin","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["linkedin profile","linkedin url","linkedin"]},
    {"id":"identity.street_address","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["home street address","street address","address line 1"]},
    {"id":"identity.city","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["city / municipality","city","municipality"]},
    {"id":"identity.region","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["state","state / province","province","region"]},
    {"id":"identity.postal_code","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["zip code","postal code","zip"]},
    {"id":"identity.country","family":"identity-contact","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["country","country of residence"]},
    {"id":"eeo.disability_status","family":"eeo-demographics","sensitivity":"sensitive-demographic","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["are you an individual with a disability","disability status","voluntary self-identification of disability"],"notes":"Never infer from medical text."},
    {"id":"eeo.veteran_status","family":"eeo-demographics","sensitivity":"sensitive-demographic","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["have you ever served in the us armed forces","veteran status","protected veteran status"]},
    {"id":"eeo.race_ethnicity","family":"eeo-demographics","sensitivity":"sensitive-demographic","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["race / ethnicity","race and ethnicity","race","ethnicity"]},
    {"id":"eeo.gender","family":"eeo-demographics","sensitivity":"sensitive-demographic","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["gender","sex"]},
    {"id":"employment.prior_employer_relationship","family":"employment-eligibility","sensitivity":"employment-history","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"confirm_each_application","aliases":["have you ever worked for this company or any subsidiary or affiliate before","have you previously worked for us","former employee"]},
    {"id":"employment.work_authorization_proof","family":"employment-eligibility","sensitivity":"eligibility","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"confirm_each_application","aliases":["if you are hired can you present proof of your legal right to work","authorized to work","work authorization"]},
    {"id":"employment.sponsorship_required","family":"employment-eligibility","sensitivity":"eligibility","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"confirm_each_application","aliases":["do you now or will you in the future require sponsorship","require sponsorship for employment-based visa status","visa sponsorship"]},
    {"id":"compensation.desired_annual_salary","family":"compensation-education-accommodation","sensitivity":"financial","answer_scope":"opportunity","automation_policy":"fill_if_explicit_preference","confirmation_policy":"per_opportunity","aliases":["what is your desired annual target salary","desired salary","salary expectation","target compensation"],"notes":"Prefer opportunity-specific value."},
    {"id":"compensation.currency","family":"compensation-education-accommodation","sensitivity":"financial","answer_scope":"opportunity","automation_policy":"fill_if_explicit_preference","confirmation_policy":"per_opportunity","aliases":["desired annual target salary currency","salary currency","currency"]},
    {"id":"education.highest_completed_level","family":"compensation-education-accommodation","sensitivity":"personal","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","aliases":["highest level of completed education","highest education level","education level"]},
    {"id":"accommodation.reasonable_accommodation_needed","family":"compensation-education-accommodation","sensitivity":"sensitive-accommodation","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"confirm_each_application","aliases":["do you need any reasonable accommodations in order to perform the responsibilities of this position","reasonable accommodation","accommodation needed"],"notes":"Never infer from disability preference."},
    {"id":"legal.non_compete_blocking","family":"legal-compliance","sensitivity":"legal-current","answer_scope":"profile","automation_policy":"fill_if_confirmed_current","confirmation_policy":"confirm_each_application","aliases":["are you currently bound by a non-compete or any other agreement that would prevent you from executing your responsibilities","non-compete agreement","restrictive covenant"]},
    {"id":"legal.debarment_exclusion_status","family":"legal-compliance","sensitivity":"legal-current","answer_scope":"profile","automation_policy":"fill_if_confirmed_current","confirmation_policy":"confirm_each_application","aliases":["are you currently or have you ever been debarred excluded suspended and/or declared ineligible","debarred excluded suspended ineligible","government contracts eligibility"]},
    {"id":"legal.debarment_investigation_pending","family":"legal-compliance","sensitivity":"legal-current","answer_scope":"profile","automation_policy":"fill_if_confirmed_current","confirmation_policy":"confirm_each_application","aliases":["is any agency action or investigation relating to debarment exclusion suspension and/or a declaration of ineligibility currently pending or threatened","debarment investigation","government agency investigation"]},
    {"id":"attestation.truth_accuracy","family":"certification-navigation","sensitivity":"attestation","answer_scope":"session","automation_policy":"manual_only","confirmation_policy":"manual_each_submission","aliases":["i certify that this information is true and accurate to the best of my knowledge","certify information is true and accurate","certification"],"notes":"Never auto-check, auto-sign, or submit."},
    {"id":"skills.jira_administration_level","family":"role-fit-claims","sensitivity":"professional-claim","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","claim_policy":"evidence_backed","aliases":["do you have hands-on expertise administering and configuring jira","jira administration level","jira admin proficiency","jira workflows boards custom fields permissions jql"],"notes":"Rate Jira-specific administration/configuration evidence only. Viewing or editing tickets does not establish workflows, boards, custom fields, permissions, or JQL administration."},
    {"id":"skills.confluence_level","family":"role-fit-claims","sensitivity":"professional-claim","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","claim_policy":"evidence_backed","aliases":["do you have a strong working knowledge of confluence","confluence proficiency","confluence spaces pages templates documentation structure"],"notes":"Rate Confluence-specific use. Generic SOP, runbook, or documentation skill does not by itself establish Confluence experience."},
    {"id":"skills.presentation_level","family":"role-fit-claims","sensitivity":"professional-claim","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","claim_policy":"evidence_backed","aliases":["how would you rate your powerpoint skills","powerpoint proficiency","presentation skills"],"notes":"Rate demonstrated presentation-production capability, not frequency alone. Advanced may be supported by turning complex information into polished stakeholder-ready presentations; Expert requires evidence of high-impact senior-leadership, board, or executive-client presentations."},
    {"id":"industry.utilities_energy_experience","family":"role-fit-claims","sensitivity":"professional-claim","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"until_changed","claim_policy":"evidence_backed","aliases":["do you have experience working with utilities clients or in the utilities energy industry","utilities industry experience","energy industry experience","ami gis oms adms cis implementations"],"notes":"Claim only actual utilities/energy client or industry experience. Adjacent technical implementation work is not a substitute."},
    {"id":"credentials.relevant_certification_status","family":"role-fit-claims","sensitivity":"professional-claim","answer_scope":"profile","automation_policy":"fill_if_explicit_preference","confirmation_policy":"confirm_each_application","claim_policy":"evidence_backed","aliases":["do you hold any relevant certifications or are you pursuing any certifications that we should be aware of","relevant certifications","certification status","certifications pursuing"],"notes":"A pursuit claim requires concrete current activity toward the credential; future intent alone is not pursuing. Never upgrade a course or study interest into a certification."}
  ]
}
