      "coach_prompt": "Verify the app opens and preserves my workspace",
      "primary_action": "INSTALL_STATUS",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "HOME_READY",
      "entry_evidence": "managed runtime healthy",
      "required_evidence": [
        "workspace_loaded"
      ],
      "coach_prompt": "Paste a job link to begin",
      "primary_action": "NAVIGATE_INTAKE",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "OPPORTUNITY_INTAKE",
      "entry_evidence": "job URL selected",
      "required_evidence": [
