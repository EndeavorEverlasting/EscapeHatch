      "coach_prompt": "Choose how to install missing components",
      "primary_action": "INSTALL_REVIEW",
      "completion": "specific_observed_evidence_only",
      "resume_key": "opportunity_id_and_application_url",
      "terminal_submit_automated": false
    },
    {
      "id": "INSTALL_VERIFY",
      "entry_evidence": "installer reports completion",
