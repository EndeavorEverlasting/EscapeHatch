{
  "schema": "escapehatch/employer-facing-document-url/v1",
  "version": 1,
  "owner": "contracts/employer-facing-document-url.v1.json",
  "purpose": "Prevent agents and fill paths from placing private-cloud document links into employer-visible resume/CV/transcript/cover URL fields.",
  "document_url_field_label_pattern": "\\b(resume|résumé|cv|curriculum\\s*vitae|transcript|cover[\\s-]?letter)\\b",
  "forbidden_url_host_suffixes": [
    "drive.google.com",
    "docs.google.com",
    "sheets.google.com",
    "drive.usercontent.google.com",
    "docs.googleusercontent.com"
  ],
  "allowed_examples": [
    "https://www.perezparallax.dev/static/resume/current.html",
    "applicant-controlled public HTTPS resume or portfolio URLs"
  ],
  "forbidden_examples": [
    "https://drive.google.com/file/d/<id>/view",
    "https://docs.google.com/document/d/<id>/edit",
    "https://drive.google.com/uc?id=<id>&export=download"
  ],
  "runtime_enforcement": {
    "pure_module": "artifacts/escape-hatch/src/lib/employer-facing-document-url.ts",
    "fill_path": "artifacts/escape-hatch/managed-form.ts",
    "manual_type_path": "artifacts/escape-hatch/browser-assist-control.ts#type-labeled",
    "error_code": "private_cloud_document_url_forbidden"
  },
  "privacy": {
    "rule": "Employer ATS fields must not receive Google Drive/Docs links that require the employer's Google account access or expose private Drive ACL assumptions."
  }
}
