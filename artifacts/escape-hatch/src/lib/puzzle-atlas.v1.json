{
  "schema_version": "escapehatch-puzzle-atlas/v1",
  "canonical_existing_gallery": "src/lib/profile-puzzle-gallery.v1.json",
  "release_status": "source-atlas; nine illustration binaries staged in the attached source bundle until independently committed and hash-checked",
  "rules": [
    "Each module is a distinct evidence domain; do not recycle the ten profile-piece keys across modules.",
    "Illustrations are decorative; uninspected data is unmeasured, not missing or saved.",
    "Variants change presentation only, never approval, field state, ATS readiness, or reward authority.",
    "No private answer values, resume text, employer links, or tokens belong in the public catalog.",
    "Future illustration variants are independent hashed assets attached to a module and never overwrite an earlier original or make unrelated evidence complete."
  ],
  "answer_kinds": [
    {
      "id": "standard",
      "label": "Standard answers",
      "scope": "Reusable only with explicit reviewed preference",
      "examples": [
        "availability",
        "work authorization",
        "work mode",
        "compensation"
      ],
      "policy": "Use existing question taxonomy and confirmation policy; sensitive or legal statements require the owning gate."
    },
    {
      "id": "narrative",
      "label": "Narrative answers",
      "scope": "Reviewed reusable career story",
      "examples": [
        "professional summary",
        "strengths",
        "relevant experience"
      ],
      "policy": "Preserve authentic version and source; alternative phrasings are drafts until accepted."
    },
    {
      "id": "rare",
      "label": "Rare / exact-question answers",
      "scope": "Exact question or exact opportunity only",
      "examples": [
        "unusual employer prompts",
        "role-specific scenarios"
      ],
      "policy": "Do not promote to globally reusable memory merely because it is saved."
    },
    {
      "id": "restricted",
      "label": "Sensitive or attestation",
      "scope": "Never silently reusable",
      "examples": [
        "EEO",
        "legal consent",
        "signatures"
      ],
      "policy": "Operator-only confirmation; an illustration or saved string is no authorization."
    }
  ],
